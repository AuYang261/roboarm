@@ -453,8 +453,14 @@ def apply_model_freezing(
 
     # Freeze multimodal LLM (keep only expert/action parameters active)
     if training_args.freeze_mllm:
+        # Expert-related parameter name patterns that should NOT be frozen
+        EXPERT_PATTERNS = ("mot_gen", "action_encoder", "action_decoder",
+                          "proprio_encoder", "mpg", "action_to_vlm", "vlm_to_action")
         for name, param in model.named_parameters():
             if name in mllm_layer_names:
+                # Skip expert/action parameters — they must remain trainable
+                if any(p in name for p in EXPERT_PATTERNS):
+                    continue
                 param.requires_grad = False
             if "connector" in name and training_args.freeze_vit_mlp:
                 param.requires_grad = False
@@ -948,7 +954,17 @@ def main():
     model.vit_model.gradient_checkpointing = True
     model.vit_model.encoder.gradient_checkpointing = True
     if model_args.grad_checkpoint:
-        model.language_model._set_gradient_checkpointing()
+        from torch.utils.checkpoint import checkpoint
+        # Apply gradient checkpointing on the inner Qwen3Model (not the wrapper)
+        # _set_gradient_checkpointing fails on Qwen3ForCausalLM because it
+        # doesn't have the gradient_checkpointing attribute on the wrapper itself
+        inner_model = model.language_model.model
+        inner_model._gradient_checkpointing_func = checkpoint
+        inner_model.gradient_checkpointing = True
+        for layer in inner_model.layers:
+            layer._gradient_checkpointing_func = checkpoint
+            layer.gradient_checkpointing = True
+        logger.info("Gradient checkpointing enabled on LLM decoder layers")
     for name, param in model.named_parameters():
         if torch.isnan(param.data).any():
             breakpoint()
