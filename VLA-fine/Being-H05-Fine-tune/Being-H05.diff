+class KochFollowerDataConfig(BaseDataConfig):
+    """DataConfig for Koch follower arm (5 arm joints + 1 gripper, joint-space control)."""
+    VIDEO_KEYS = ['video.above', 'video.wrist']
+    VIDEO_SOURCE_COLUMNS = {
+        'video.above': 'observation.images.above',
+        'video.wrist': 'observation.images.wrist',
+    }
+    STATE_KEYS = ['state.arm_joint_position', 'state.gripper_position']
+    ACTION_KEYS = ['action.arm_joint_position', 'action.gripper_position']
+
+    UNIFIED_MAPPING: Dict[str, Tuple[int, int]] = {
+        'state.arm_joint_position': (50, 55),
+        'state.gripper_position': (18, 19),
+        'action.arm_joint_position': (50, 55),
+        'action.gripper_position': (18, 19),
+    }
+
+    state_normalization_modes = {
+        'state.arm_joint_position': 'min_max',
+        'state.gripper_position': 'min_max',
+    }
+
+    action_normalization_modes = {
+        'action.arm_joint_position': 'min_max',
+        'action.gripper_position': 'min_max',
+    }
+
+    def get_feature_meta(self):
+        return {
+            'state.arm_joint_position': ("5-d absolute arm joint position (shoulder_pan, shoulder_lift, elbow_flex, wrist_flex, wrist_roll)", 5),
+            'state.gripper_position': ("1-d gripper position", 1),
+            'action.arm_joint_position': ("5-d absolute arm joint position", 5),
+            'action.gripper_position': ("1-d gripper position", 1),
+        }
+
+    def define_modalities(self) -> Dict[str, ModalityDef]:
+        modalities = {
+            'language.instruction': ModalityDef(source_column='task_index', start=0, end=0),
+            'state.arm_joint_position': ModalityDef(source_column='observation.state', start=0, end=5),
+            'state.gripper_position': ModalityDef(source_column='observation.state', start=5, end=6),
+            'action.arm_joint_position': ModalityDef(source_column='action', start=0, end=5),
+            'action.gripper_position': ModalityDef(source_column='action', start=5, end=6),
+        }
+        modalities = self.add_video_modality(modalities)
+        return modalities
+
+    def get_transforms(self) -> ModalityTransform:
+        transforms = [
+            StateActionToTensor(apply_to=self.STATE_KEYS),
+            StateActionTransform(
+                apply_to=self.STATE_KEYS,
+                normalization_modes=self.state_normalization_modes,
+            ),
+            StateActionToTensor(apply_to=self.ACTION_KEYS),
+            StateActionTransform(
+                apply_to=self.ACTION_KEYS,
+                normalization_modes=self.action_normalization_modes,
+            ),
+        ]
+        return ComposedModalityTransform(transforms=transforms)
+
+
 DATA_CONFIG_MAP = {
     "libero_nonorm": LiberoNoNormDataConfig,
     "robocasa_human": RobocasaHumanDataConfig,
+    "koch_follower": KochFollowerDataConfig,
 }
