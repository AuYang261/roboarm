+# ==============================================================================
+# VLA Configuration
+# ==============================================================================
+
+@dataclass
+class VLAPolicyConfig:
+    """Configuration for Being-H05 VLA policy inference."""
+
+    # Path to Being-H05 checkpoint directory
+    model_path: str | None = field(
+        default=None,
+        metadata={"help": "Path to Being-H05 checkpoint (containing config.json + safetensors)"},
+    )
+
+    # Being-H05 data config name
+    data_config_name: str = field(
+        default="koch_follower",
+        metadata={"help": "Being-H05 data config name"},
+    )
+
+    # Dataset name for loading normalization metadata
+    dataset_name: str = field(
+        default="koch_posttrain",
+        metadata={"help": "Dataset group name for metadata"},
+    )
+
+    # Robot embodiment tag
+    embodiment_tag: str = field(
+        default="koch",
+        metadata={"help": "Robot embodiment identifier"},
+    )
+
+    # Camera key mapping: LeRobot camera name → Being-H05 video key
+    camera_above_key: str = field(
+        default="above",
+        metadata={"help": "LeRobot camera key for the overhead view (→ video.above)"},
+    )
+    camera_wrist_key: str = field(
+        default="wrist",
+        metadata={"help": "LeRobot camera key for the wrist view (→ video.wrist)"},
+    )
+
+    # Task description
+    single_task: str = field(
+        default="pick up the object",
+        metadata={"help": "Task instruction for VLA inference"},
+    )
+
+    # Instruction template with {task_description} and {k} placeholders
+    instruction_template: str = field(
+        default=(
+            "According to the instruction '{task_description}', "
+            "what's the micro-step actions in the next {k} steps?"
+        ),
+        metadata={"help": "Prompt template for task instruction"},
+    )
+
+    # Flow matching parameters
+    num_inference_timesteps: int | None = field(
+        default=None,
+        metadata={"help": "Override flow matching ODE steps (default from checkpoint)"},
+    )
+
+    # RTC (Real-Time Chunking) settings
+    use_rtc: bool = field(
+        default=True,
+        metadata={"help": "Enable Real-Time Chunking with prefix locking"},
+    )
+    action_chunk_length: int = field(
+        default=16,
+        metadata={"help": "Number of action steps per chunk (must match model config)"},
+    )
+    n_action_steps: int = field(
+        default=4,
+        metadata={"help": "Number of steps to execute from each chunk before re-inference"},
+    )
+
+    # Device
+    device: str = field(
+        default="cuda" if __import__("torch").cuda.is_available() else "cpu",
+        metadata={"help": "Device for VLA inference"},
+    )
+
+
+# ==============================================================================
+# Top-level Config
+# ==============================================================================
+
+@dataclass
+class VLARecordConfig:
+    robot: RobotConfig
+    # VLA policy config (if set, uses VLA instead of teleop)
+    vla: VLAPolicyConfig = field(default_factory=VLAPolicyConfig)
+    # Dataset recording config (optional — if not set, no recording)
+    dataset: DatasetRecordConfig | None = None
+    # Teleoperator (only used in teleop mode, ignored in VLA mode)
+    teleop: TeleoperatorConfig | None = None
+    # Control settings
+    control: "ControlConfig" = field(default_factory=lambda: ControlConfig())
+    # Display
+    display_data: bool = False
+    display_ip: str | None = None
+    display_port: int | None = None
+    display_compressed_images: bool = False
+    play_sounds: bool = True
+
+    def __post_init__(self):
+        is_vla_mode = self.vla.model_path is not None
+        is_teleop_mode = self.teleop is not None
+
+        if not is_vla_mode and not is_teleop_mode:
+            raise ValueError(
+                "Either --vla.model_path (VLA mode) or --teleop.type (teleop mode) must be set. "
+                "For VLA mode: --vla.model_path=/path/to/Being-H05/checkpoint "
+                "For teleop mode: --teleop.type=koch_leader"
+            )
+
+        if is_vla_mode and is_teleop_mode:
+            logging.warning(
+                "Both VLA and teleop configured. Using VLA mode (teleop will be ignored)."
+            )
+
+        if is_vla_mode and self.dataset is not None:
+            repo_name = self.dataset.repo_id.split("/", 1)[-1]
+            if repo_name.startswith("eval_"):
+                raise ValueError(
+                    "Dataset names starting with 'eval_' are reserved. "
+                    "Use a different name for VLA-recorded datasets."
+                )
+
+
+@dataclass
+class ControlConfig:
+    """Control loop settings."""
+    fps: int = 20
+    num_steps: int = 200
+    episode_time_s: int | None = None  # Alternative to num_steps
+    reset_time_s: float = 2.0
+
+
+# ==============================================================================
+# Observation/Action format conversion
+# ==============================================================================
+
+# Koch motor names in LeRobot (order must match Being-H05's arm_joint + gripper)
+KOCH_MOTOR_NAMES = [
+    "shoulder_pan",
+    "shoulder_lift",
+    "elbow_flex",
+    "wrist_flex",
+    "wrist_roll",
+    "gripper",
+]
+KOCH_MOTOR_KEYS = [f"{name}.pos" for name in KOCH_MOTOR_NAMES]
+
+
+def robot_obs_to_beingh_obs(
+    raw_obs: RobotObservation,
+    config: VLAPolicyConfig,
+) -> dict[str, Any]:
+    """
+    Convert LeRobot KochFollower RobotObservation to Being-H05 BeingHPolicy format.
+
+    LeRobot RobotObservation (flat dict):
+        {
+            "shoulder_pan.pos": 1.23,
+            "shoulder_lift.pos": 0.45,
+            "elbow_flex.pos": -0.67,
+            "wrist_flex.pos": 1.89,
+            "wrist_roll.pos": 0.12,
+            "gripper.pos": 50.0,
+            "above": np.ndarray(H, W, 3),   # camera name from robot config
+            "wrist": np.ndarray(H, W, 3),
+        }
+
+    Being-H05 BeingHPolicy format:
+        {
+            "video.above": np.ndarray(H, W, 3) uint8,
+            "video.wrist": np.ndarray(H, W, 3) uint8,
+            "state.arm_joint_position": np.ndarray(5,) float32,
+            "state.gripper_position": np.ndarray(1,) float32,
+            "language.instruction": ["task description"],
+        }
+    """
+    # Extract motor states in fixed order
+    state_array = np.array(
+        [float(raw_obs[k]) for k in KOCH_MOTOR_KEYS],
+        dtype=np.float32,
+    )
+
+    # Extract camera images
+    above_img = _extract_image(raw_obs, config.camera_above_key, "above")
+    wrist_img = _extract_image(raw_obs, config.camera_wrist_key, "wrist")
+
+    return {
+        "video.above": above_img,
+        "video.wrist": wrist_img,
+        "state.arm_joint_position": state_array[:5].copy(),
+        "state.gripper_position": state_array[5:6].copy(),
+        "language.instruction": [config.single_task],
+    }
+
+
+def beingh_result_to_robot_action(
+    result: dict[str, Any],
+    step_index: int = 0,
+) -> RobotAction:
+    """
+    Convert Being-H05 action result to LeRobot KochFollower RobotAction format.
+
+    Being-H05 output:
+        {
+            "action.arm_joint_position": [[...] * 16],   # (16, 5)
+            "action.gripper_position":    [[...] * 16],   # (16, 1)
+            "action_unified":             [[...] * 16],   # (16, 200) optional
+        }
+
+    LeRobot RobotAction (flat dict for KochFollower.send_action()):
+        {
+            "shoulder_pan.pos": 1.23,
+            "shoulder_lift.pos": 0.45,
+            "elbow_flex.pos": -0.67,
+            "wrist_flex.pos": 1.89,
+            "wrist_roll.pos": 0.12,
+            "gripper.pos": 50.0,
+        }
+    """
+    arm_actions = np.array(result["action.arm_joint_position"], dtype=np.float64)
+    gripper_actions = np.array(result["action.gripper_position"], dtype=np.float64)
+
+    # Extract the specified step
+    if arm_actions.ndim == 2:
+        arm_step = arm_actions[step_index]   # (5,)
+    else:
+        arm_step = arm_actions
+
+    if gripper_actions.ndim == 2:
+        grip_step = gripper_actions[step_index]  # (1,)
+    else:
+        grip_step = gripper_actions
+
+    # Build flat dict matching Koch motor names
+    action_dict: RobotAction = {}
+    for i, motor_key in enumerate(KOCH_MOTOR_KEYS[:5]):
+        action_dict[motor_key] = float(arm_step[i])
+    action_dict[KOCH_MOTOR_KEYS[5]] = float(grip_step.item() if hasattr(grip_step, 'item') else grip_step)
+
+    return action_dict
+
+
+def _extract_image(raw_obs: dict, camera_key: str, fallback_key: str) -> np.ndarray:
+    """Extract RGB image from raw robot observation dict."""
+    for key in [camera_key, fallback_key]:
+        if key in raw_obs:
+            img = raw_obs[key]
+            break
+    else:
+        raise KeyError(
+            f"Cannot find camera '{camera_key}' or '{fallback_key}' "
+            f"in observation. Available keys: {list(raw_obs.keys())}"
+        )
+
+    img = np.asarray(img)
+    if img.dtype != np.uint8:
+        if img.max() <= 1.0:
+            img = (img * 255).astype(np.uint8)
+        else:
+            img = img.astype(np.uint8)
+    return img
+
+
+# ==============================================================================
+# VLA Record Loop
+# ==============================================================================
+
+@safe_stop_image_writer
+def vla_record_loop(
+    robot: Robot,
+    vlapolicy: Any,  # BeingHPolicy instance
+    events: dict,
+    fps: int,
+    robot_action_processor: RobotProcessorPipeline,
+    robot_observation_processor: RobotProcessorPipeline,
+    vla_config: VLAPolicyConfig,
+    dataset: LeRobotDataset | None = None,
+    control_time_s: int | None = None,
+    single_task: str | None = None,
+    display_data: bool = False,
+    display_compressed_images: bool = False,
+):
+    """
+    Main control loop: robot observation → VLA inference → robot action → (record).
+
+    Data flow:
+        robot.get_observation()            → raw_obs
+        robot_observation_processor(obs)   → processed_obs
+        robot_obs_to_beingh_obs(obs, cfg)  → beingh_obs
+        vlapolicy.get_action(beingh_obs)   → vla_result
+        beingh_result_to_robot_action()    → robot_action
+        robot_action_processor(action)     → action_to_send
+        robot.send_action(action_to_send)  → execute
+        dataset.add_frame(frame)           → record (optional)
+
+    RTC mode (use_rtc=True):
+        - Model predicts 16-step chunk
+        - Execute n_action_steps (default 4)
+        - Re-query model with prev_chunk for prefix locking
+        - Repeat
+    """
+    if dataset is not None and dataset.fps != fps:
+        raise ValueError(
+            f"Dataset fps ({dataset.fps}) must match control fps ({fps})."
+        )
+
+    control_interval = 1.0 / fps
+    num_action_steps = vla_config.n_action_steps
+    use_rtc = vla_config.use_rtc
+
+    # RTC state
+    prev_chunk = None
+    action_buffer: list[RobotAction] = []
+    chunk_step = 0
+
+    timestamp = 0.0
+    start_episode_t = time.perf_counter()
+
+    while True:
+        # Check termination
+        if control_time_s is not None and timestamp >= control_time_s:
+            break
+        if events.get("exit_early", False):
+            events["exit_early"] = False
+            break
+
+        start_loop_t = time.perf_counter()
+
+        # Step 1: Get robot observation
+        raw_obs = robot.get_observation()
+        processed_obs = robot_observation_processor(raw_obs)
+
+        # Build dataset observation frame (if recording)
+        if dataset is not None:
+            observation_frame = build_dataset_frame(
+                dataset.features, processed_obs, prefix=OBS_STR
+            )
+
+        # Step 2: Get action (from VLA or from buffer)
+        if len(action_buffer) == 0:
+            # Convert to Being-H05 format
+            beingh_obs = robot_obs_to_beingh_obs(raw_obs, vla_config)
+
+            # RTC: pass previous chunk for prefix locking
+            if use_rtc and prev_chunk is not None:
+                beingh_obs["prev_chunk"] = prev_chunk
+                beingh_obs["inference_delay"] = num_action_steps
+
+            # VLA inference
+            result = vlapolicy.get_action(beingh_obs)
+
+            # Cache unified actions for next RTC query
+            if use_rtc:
+                prev_chunk = result.get("action_unified")
+
+            # Build action buffer from result
+            action_buffer = []
+            chunk_len = len(result["action.arm_joint_position"])
+            for i in range(chunk_len):
+                action_buffer.append(
+                    beingh_result_to_robot_action(result, step_index=i)
+                )
+            chunk_step = 0
+
+        # Pop action from buffer
+        raw_vla_action = action_buffer.pop(0)
+        chunk_step += 1
+
+        # Step 3: Process action through robot action processor
+        robot_action_to_send = robot_action_processor((raw_vla_action, processed_obs))
+
+        # Step 4: Send action to robot
+        robot.send_action(robot_action_to_send)
+
+        # Step 5: Record to dataset (if enabled)
+        if dataset is not None:
+            raw_vla_action_for_dataset = raw_vla_action.copy()
+            action_frame = build_dataset_frame(
+                dataset.features, raw_vla_action_for_dataset, prefix=ACTION
+            )
+            frame = {**observation_frame, **action_frame, "task": single_task}
+            dataset.add_frame(frame)
+
+        # Step 6: Display (if enabled)
+        if display_data:
+            log_rerun_data(
+                observation=processed_obs,
+                action=raw_vla_action,
+                compress_images=display_compressed_images,
+            )
+
+        # Step 7: Timing
+        dt_s = time.perf_counter() - start_loop_t
+        sleep_time_s = control_interval - dt_s
+        if sleep_time_s < 0:
+            logging.warning(
+                f"Control loop running slow ({1.0 / dt_s:.1f} Hz vs target {fps} Hz). "
+                f"VLA inference may be the bottleneck."
+            )
+        precise_sleep(max(sleep_time_s, 0.0))
+
+        timestamp = time.perf_counter() - start_episode_t
+
+
+# ==============================================================================
+# Main entry point
+# ==============================================================================
+
+@parser.wrap()
+def record_vla(
+    cfg: VLARecordConfig,
+    robot_action_processor: RobotProcessorPipeline | None = None,
+    robot_observation_processor: RobotProcessorPipeline | None = None,
+) -> LeRobotDataset | None:
+    """Main entry point for VLA-adapted recording / inference."""
+    init_logging()
+    logging.info(pformat({
+        "robot_type": cfg.robot.type if hasattr(cfg.robot, 'type') else str(cfg.robot),
+        "vla_model_path": cfg.vla.model_path,
+        "vla_task": cfg.vla.single_task,
+        "control_fps": cfg.control.fps,
+        "dataset": cfg.dataset.repo_id if cfg.dataset else None,
+    }))
+
+    if cfg.display_data:
+        init_rerun(session_name="vla_recording", ip=cfg.display_ip, port=cfg.display_port)
+
+    display_compressed = (
+        True
+        if (cfg.display_data and cfg.display_ip is not None and cfg.display_port is not None)
+        else cfg.display_compressed_images
+    )
+
+    is_vla_mode = cfg.vla.model_path is not None
+
+    # ============================================================
+    # Initialize robot
+    # ============================================================
+    robot = make_robot_from_config(cfg.robot)
+    logging.info(f"Robot: {robot.name}")
+
+    # ============================================================
+    # Initialize VLA policy (VLA mode)
+    # ============================================================
+    vlapolicy = None
+    if is_vla_mode:
+        logging.info(f"Loading Being-H05 VLA policy from {cfg.vla.model_path}")
+
+        # Setup beingh import path
+        beingh_checkpoint = Path(cfg.vla.model_path).resolve()
+        beingh_root = beingh_checkpoint.parent.parent
+        if str(beingh_root) not in sys.path:
+            sys.path.insert(0, str(beingh_root))
+
+        from BeingH.inference.beingh_policy import BeingHPolicy
+
+        vlapolicy = BeingHPolicy(
+            model_path=str(beingh_checkpoint),
+            data_config_name=cfg.vla.data_config_name,
+            dataset_name=cfg.vla.dataset_name,
