+#!/usr/bin/env python3
+"""
+离线视频推理脚本 - Being-H05 VLA Model
+
+从 LeRobot v2.1 格式数据集读取视频流和状态数据，
+使用 Being-H05 模型进行离线动作推理，保存推理结果。
+
+两种推理模式:
+    1. single_frame: 单帧独立推理（Open-Loop），从每帧独立预测16步动作
+    2. rtc_rollout: 滚动推理（Closed-Loop with RTC），模拟真实部署场景
+
+Usage:
+    # 单帧推理
+    python offline_inference.py \
+        --data_path origin_data_v21/koch_follower/pick_orange_simple_shape \
+        --checkpoint Being-H05/checkpoints/koch_all_data_20260603_214251/0010000 \
+        --output_dir output/inference/pick_orange_simple_shape \
+        --mode single_frame
+
+    # RTC 滚动推理
+    python offline_inference.py \
+        --data_path origin_data_v21/koch_follower/pick_orange_simple_shape \
+        --checkpoint Being-H05/checkpoints/koch_all_data_20260603_214251/0010000 \
+        --output_dir output/inference/pick_orange_simple_shape \
+        --mode rtc_rollout \
+        --n_action_steps 4
+"""
+
+import argparse
+import json
+import logging
+import os
+import sys
+import time
+import traceback
+from pathlib import Path
+from typing import Any, Dict, List, Optional, Tuple
+
+import numpy as np
+import pandas as pd
+import torch
+from matplotlib import pyplot as plt
+
+# ==============================================================================
+# Path Setup
+# ==============================================================================
+# Add Being-H05 root to Python path for imports
+_script_dir = Path(__file__).resolve().parent
+_beingh_root = _script_dir.parent.parent  # Being-H05/
+if str(_beingh_root) not in sys.path:
+    sys.path.insert(0, str(_beingh_root))
+
+# Add project root to Python path (for lerobot, etc.)
+_project_root = _beingh_root.parent  # Being-H/
+if str(_project_root) not in sys.path:
+    sys.path.insert(0, str(_project_root))
+
+# ==============================================================================
+# Imports (deferred for clean error messages)
+# ==============================================================================
+
+try:
+    import decord
+    from decord import VideoReader
+    HAS_DECORD = True
+except ImportError:
+    HAS_DECORD = False
+    print("Warning: decord not installed. Install with: pip install decord")
+
+try:
+    from BeingH.inference.beingh_policy import BeingHPolicy
+except ImportError as e:
+    print(f"Error importing BeingHPolicy: {e}")
+    print("Make sure the script is run from the Being-H/ directory")
+    print(f"sys.path: {sys.path[:3]}...")
+    sys.exit(1)
+
+# ==============================================================================
+# Logging Setup
+# ==============================================================================
+
+logging.basicConfig(
+    level=logging.INFO,
+    format='%(asctime)s | %(levelname)-8s | %(message)s',
+    datefmt='%H:%M:%S',
+)
+logger = logging.getLogger(__name__)
+
+
+# ==============================================================================
+# Data Loading Utilities
+# ==============================================================================
+
+# Koch motor names (matching LeRobot v2.1 format)
+KOCH_MOTOR_NAMES = [
+    "shoulder_pan",
+    "shoulder_lift",
+    "elbow_flex",
+    "wrist_flex",
+    "wrist_roll",
+    "gripper",
+]
+
+
+def load_episode_parquet(data_dir: Path, episode_idx: int) -> pd.DataFrame:
+    """Load parquet data for a single episode."""
+    chunk_idx = episode_idx // 1000  # LeRobot chunks by 1000 episodes
+    parquet_path = data_dir / f"data/chunk-{chunk_idx:03d}/episode_{episode_idx:06d}.parquet"
+    if not parquet_path.exists():
+        raise FileNotFoundError(f"Parquet file not found: {parquet_path}")
+    return pd.read_parquet(parquet_path)
+
+
+def load_episode_video(videos_dir: Path, camera_key: str, episode_idx: int) -> np.ndarray:
+    """
+    Load all frames from an episode video.
+
+    Args:
+        videos_dir: Base videos directory
+        camera_key: e.g. 'observation.images.above' or 'observation.images.wrist'
+        episode_idx: Episode index
+
+    Returns:
+        Frames as numpy array of shape (N, H, W, C) in uint8 (RGB)
+    """
+    chunk_idx = episode_idx // 1000
+    video_path = videos_dir / f"chunk-{chunk_idx:03d}/{camera_key}/episode_{episode_idx:06d}.mp4"
+
+    if not video_path.exists():
+        raise FileNotFoundError(f"Video file not found: {video_path}")
+
+    if HAS_DECORD:
+        vr = VideoReader(str(video_path), num_threads=2)
+        frames = vr.get_batch(range(len(vr))).asnumpy()  # (N, H, W, C) uint8 RGB
+    else:
+        # Fallback to OpenCV
+        import cv2
+        cap = cv2.VideoCapture(str(video_path))
+        frames = []
+        while True:
+            ret, frame = cap.read()
+            if not ret:
+                break
+            frame_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
+            frames.append(frame_rgb)
+        cap.release()
+        frames = np.array(frames)
+
+    return frames
+
+
+def load_task_instruction(meta_dir: Path) -> str:
+    """Load the task instruction from tasks.jsonl."""
+    tasks_path = meta_dir / "tasks.jsonl"
+    if tasks_path.exists():
+        with open(tasks_path, "r") as f:
+            tasks = [json.loads(line.strip()) for line in f if line.strip()]
+        if tasks:
+            return tasks[0].get("task", "pick up the object")
+    return "pick up the object"
+
+
+def load_dataset_info(meta_dir: Path) -> Dict[str, Any]:
+    """Load dataset info.json."""
+    info_path = meta_dir / "info.json"
+    with open(info_path, "r") as f:
+        return json.load(f)
+
+
+# ==============================================================================
+# Observation Builder
+# ==============================================================================
+
+def build_observation(
+    frame_above: np.ndarray,
+    frame_wrist: np.ndarray,
+    state_6d: np.ndarray,
+    instruction: str,
+) -> Dict[str, Any]:
+    """
+    Build Being-H05 format observation from raw data.
+
+    NOTE: State keys MUST come before video keys in the dict. BeingHPolicy's
+    _check_is_batched() inspects the first dict value — if it's a 3D image array,
+    it incorrectly assumes the observation is already batched and skips the
+    unsqueeze step, causing a shape mismatch downstream.
+
+    Args:
+        frame_above: Above camera frame (H, W, 3) uint8
+        frame_wrist: Wrist camera frame (H, W, 3) uint8
+        state_6d: State array (6,) float32 [shoulder_pan, shoulder_lift, elbow_flex, wrist_flex, wrist_roll, gripper]
+        instruction: Task description string
+
+    Returns:
+        Observation dict in BeingHPolicy format
+    """
+    return {
+        "state.arm_joint_position": state_6d[:5].copy().astype(np.float32),
+        "state.gripper_position": state_6d[5:6].copy().astype(np.float32),
+        "video.above": frame_above.astype(np.uint8),
+        "video.wrist": frame_wrist.astype(np.uint8),
+        "language.instruction": [instruction],
+    }
+
+
+# ==============================================================================
+# Inference Core
+# ==============================================================================
+
+def run_single_frame_inference(
+    policy: BeingHPolicy,
+    data_dir: Path,
+    videos_dir: Path,
+    episode_idx: int,
+    instruction: str,
+    output_dir: Path,
+    save_plots: bool = True,
+) -> Dict[str, Any]:
+    """
+    Run single-frame (open-loop) inference on an episode.
+
+    For each frame in the episode, run inference independently.
+    Compares predicted 16-step action chunks against ground truth.
+
+    Returns:
+        Dict with predictions, ground_truth, and error metrics
+    """
+    logger.info(f"[Episode {episode_idx}] Loading data...")
+
+    # Load parquet and video
+    df = load_episode_parquet(data_dir, episode_idx)
+    frames_above = load_episode_video(videos_dir, "observation.images.above", episode_idx)
+    frames_wrist = load_episode_video(videos_dir, "observation.images.wrist", episode_idx)
+
+    num_frames = len(df)
+    min_frames = min(num_frames, len(frames_above), len(frames_wrist))
+    logger.info(f"[Episode {episode_idx}] Frames: {min_frames} (parquet={num_frames}, above={len(frames_above)}, wrist={len(frames_wrist)})")
+
+    # Extract data arrays
+    states = np.stack(df['observation.state'].values[:min_frames])  # (N, 6)
+    actions_gt = np.stack(df['action'].values[:min_frames])          # (N, 6)
+
+    # Prepare output storage
+    action_chunk_length = policy.action_chunk_length  # 16
+    num_inference_frames = min_frames - action_chunk_length + 1  # Avoid going out of bounds
+
+    all_predictions = []  # (num_inference_frames, action_chunk_length, 6)
+    all_ground_truth = [] # (num_inference_frames, action_chunk_length, 6)
+    inference_times = []
+
+    logger.info(f"[Episode {episode_idx}] Running {num_inference_frames} inferences...")
+
+    for i in range(num_inference_frames):
+        # Build observation from current frame
+        obs = build_observation(
+            frames_above[i],
+            frames_wrist[i],
+            states[i],
+            instruction,
+        )
+
+        # Run inference
+        t_start = time.perf_counter()
+        try:
+            result = policy.get_action(obs)
+        except Exception as e:
+            logger.error(f"[Episode {episode_idx}] Inference failed at frame {i}: {e}")
+            raise
+        t_elapsed = time.perf_counter() - t_start
+        inference_times.append(t_elapsed)
+
+        # Extract predicted actions
+        pred_arm = np.array(result["action.arm_joint_position"])   # (16, 5)
+        pred_grip = np.array(result["action.gripper_position"])     # (16, 1)
+        pred_6d = np.concatenate([pred_arm, pred_grip], axis=-1)   # (16, 6)
+
+        # Extract ground truth actions (next action_chunk_length steps)
+        gt_6d = actions_gt[i:i + action_chunk_length]               # (16, 6)
+        # Pad if near the end
+        if gt_6d.shape[0] < action_chunk_length:
+            pad_len = action_chunk_length - gt_6d.shape[0]
+            gt_6d = np.concatenate([gt_6d, np.tile(gt_6d[-1:], (pad_len, 1))], axis=0)
+
+        all_predictions.append(pred_6d)
+        all_ground_truth.append(gt_6d)
+
+        if (i + 1) % 50 == 0 or i == 0:
+            mean_time = np.mean(inference_times)
+            logger.info(f"[Episode {episode_idx}] Progress: {i+1}/{num_inference_frames} | "
+                       f"Avg time: {mean_time:.3f}s/frame | "
+                       f"ETA: {mean_time * (num_inference_frames - i - 1):.0f}s")
+
+    # Stack results
+    predictions = np.stack(all_predictions, axis=0)     # (F, 16, 6)
+    ground_truth = np.stack(all_ground_truth, axis=0)   # (F, 16, 6)
+
+    # Compute errors
+    errors = compute_metrics(predictions, ground_truth)
+
+    # Log summary
+    logger.info(f"[Episode {episode_idx}] Complete: "
+               f"Avg inference time: {np.mean(inference_times):.4f}s ± {np.std(inference_times):.4f}s")
+    logger.info(f"[Episode {episode_idx}] MSE per joint: {errors['mse_per_joint'].tolist()}")
+    logger.info(f"[Episode {episode_idx}] Overall MSE: {errors['mse_overall']:.6f}, MAE: {errors['mae_overall']:.6f}")
+
+    # Save results
+    ep_output_dir = output_dir / f"episode_{episode_idx:06d}"
+    ep_output_dir.mkdir(parents=True, exist_ok=True)
+
+    np.savez_compressed(ep_output_dir / "predictions.npz", predictions=predictions)
+    np.savez_compressed(ep_output_dir / "ground_truth.npz", ground_truth=ground_truth)
+    np.savez_compressed(ep_output_dir / "errors.npz", **errors)
+
+    # Save inference log
+    log_data = {
+        "episode_idx": episode_idx,
+        "num_frames": min_frames,
+        "num_inferences": num_inference_frames,
+        "action_chunk_length": action_chunk_length,
+        "avg_inference_time_s": float(np.mean(inference_times)),
+        "std_inference_time_s": float(np.std(inference_times)),
+        "mse_overall": float(errors["mse_overall"]),
+        "mae_overall": float(errors["mae_overall"]),
+        "mse_per_joint": errors["mse_per_joint"].tolist(),
+        "mae_per_joint": errors["mae_per_joint"].tolist(),
+    }
+    with open(ep_output_dir / "inference_log.json", "w") as f:
+        json.dump(log_data, f, indent=2)
+
+    # Generate plots
+    if save_plots:
+        plot_action_curves(predictions, ground_truth, KOCH_MOTOR_NAMES, ep_output_dir, episode_idx)
+
+    return log_data
+
+
+def run_rtc_rollout_inference(
+    policy: BeingHPolicy,
+    data_dir: Path,
+    videos_dir: Path,
+    episode_idx: int,
+    instruction: str,
+    output_dir: Path,
+    n_action_steps: int = 4,
+    save_plots: bool = True,
+) -> Dict[str, Any]:
+    """
+    Run closed-loop RTC (Real-Time Chunking) rollout inference.
+
+    Simulates real deployment:
+    - Model predicts 16-step chunk
+    - Execute n_action_steps (e.g. 4) from chunk
+    - Re-query model with prev_chunk for prefix locking
+    - Continue until episode ends
+
+    Returns:
+        Dict with rollout results and metrics
+    """
+    logger.info(f"[Episode {episode_idx}] Loading data for RTC rollout...")
+
+    # Load data
+    df = load_episode_parquet(data_dir, episode_idx)
+    frames_above = load_episode_video(videos_dir, "observation.images.above", episode_idx)
+    frames_wrist = load_episode_video(videos_dir, "observation.images.wrist", episode_idx)
+
+    num_frames = len(df)
+    min_frames = min(num_frames, len(frames_above), len(frames_wrist))
+    states = np.stack(df['observation.state'].values[:min_frames])
+    actions_gt = np.stack(df['action'].values[:min_frames])
+
+    action_chunk_length = policy.action_chunk_length
+
+    # RTC state
+    prev_chunk = None
+    rollout_actions = []  # Stores predicted actions executed at each step
+    rollout_states = []   # States at each step
+    inference_times = []
+
+    step = 0
+    max_steps = min_frames - 1
+
+    logger.info(f"[Episode {episode_idx}] Starting RTC rollout: max_steps={max_steps}, "
+               f"chunk_length={action_chunk_length}, n_action_steps={n_action_steps}")
+
+    while step < max_steps:
+        # Build observation
+        obs = build_observation(
+            frames_above[step],
+            frames_wrist[step],
+            states[step],
+            instruction,
+        )
+
+        # RTC: pass previous chunk for prefix locking
+        if prev_chunk is not None:
+            obs["prev_chunk"] = prev_chunk
+            obs["inference_delay"] = n_action_steps
+
+        # Inference
+        t_start = time.perf_counter()
+        try:
+            result = policy.get_action(obs)
+        except Exception as e:
+            logger.error(f"[Episode {episode_idx}] RTC inference failed at step {step}: {e}")
+            logger.error(traceback.format_exc())
+            break
+        t_elapsed = time.perf_counter() - t_start
+        inference_times.append(t_elapsed)
+
+        # Get predicted actions
+        pred_arm = np.array(result["action.arm_joint_position"])   # (16, 5)
+        pred_grip = np.array(result["action.gripper_position"])     # (16, 1)
+        pred_6d = np.concatenate([pred_arm, pred_grip], axis=-1)   # (16, 6)
+
+        # Cache unified actions for next RTC query
+        if "action_unified" in result:
+            prev_chunk = np.array(result["action_unified"])  # (16, 200)
+
+        # Execute n_action_steps from this chunk
+        for chunk_step in range(min(n_action_steps, max_steps - step)):
+            rollout_actions.append(pred_6d[chunk_step])
+            rollout_states.append(states[step + chunk_step])
+            step += 1
+
+        if step < max_steps:
+            if len(inference_times) % 10 == 0:
+                logger.info(f"[Episode {episode_idx}] RTC Step {step}/{max_steps} | "
+                           f"Inferences: {len(inference_times)} | "
+                           f"Avg time: {np.mean(inference_times):.3f}s")
+
+    # Stack results
+    rollout_actions = np.stack(rollout_actions, axis=0)   # (T, 6)
+    rollout_states = np.stack(rollout_states, axis=0)     # (T, 6)
+
+    # Trim ground truth to match rollout length
+    rollout_len = len(rollout_actions)
+    gt_actions = actions_gt[:rollout_len]
+
+    # Compute errors
+    error_per_step = np.square(rollout_actions - gt_actions).mean(axis=-1)  # (T,)
+    mse_overall = np.mean(error_per_step)
+    mae_overall = np.mean(np.abs(rollout_actions - gt_actions))
+    mse_per_joint = np.square(rollout_actions - gt_actions).mean(axis=0)   # (6,)
+    mae_per_joint = np.abs(rollout_actions - gt_actions).mean(axis=0)      # (6,)
+
+    # Cumulative error
+    cum_error = np.cumsum(error_per_step) / (np.arange(rollout_len) + 1)
+
+    logger.info(f"[Episode {episode_idx}] RTC Rollout Complete: "
+               f"{len(inference_times)} inferences, {rollout_len} steps executed")
+    logger.info(f"[Episode {episode_idx}] Overall MSE: {mse_overall:.6f}, MAE: {mae_overall:.6f}")
+
+    # Save results
+    ep_output_dir = output_dir / f"episode_{episode_idx:06d}"
+    ep_output_dir.mkdir(parents=True, exist_ok=True)
+
+    np.savez_compressed(ep_output_dir / "rollout_actions.npz", actions=rollout_actions)
+    np.savez_compressed(ep_output_dir / "rollout_states.npz", states=rollout_states)
+    np.savez_compressed(ep_output_dir / "ground_truth.npz", ground_truth=gt_actions)
+    np.savez_compressed(ep_output_dir / "cumulative_error.npz",
+                       cumulative_mse=cum_error,
+                       per_step_mse=error_per_step)
+
+    # Build output dict
+    errors = {
+        "mse_overall": float(mse_overall),
+        "mae_overall": float(mae_overall),
+        "mse_per_joint": mse_per_joint,
+        "mae_per_joint": mae_per_joint,
+    }
+
+    log_data = {
+        "mode": "rtc_rollout",
+        "episode_idx": episode_idx,
+        "num_inferences": len(inference_times),
+        "steps_executed": rollout_len,
+        "action_chunk_length": action_chunk_length,
+        "n_action_steps": n_action_steps,
+        "avg_inference_time_s": float(np.mean(inference_times)),
+        "std_inference_time_s": float(np.std(inference_times)),
+        "mse_overall": errors["mse_overall"],
+        "mae_overall": errors["mae_overall"],
+        "mse_per_joint": errors["mse_per_joint"].tolist(),
+        "mae_per_joint": errors["mae_per_joint"].tolist(),
+    }
+    with open(ep_output_dir / "inference_log.json", "w") as f:
+        json.dump(log_data, f, indent=2)
+
+    # Generate plots
+    if save_plots:
+        # Create a (T, 1, 6) prediction array for the plot function
+        pred_expanded = rollout_actions[:, np.newaxis, :]  # (T, 1, 6)
+        gt_expanded = gt_actions[:, np.newaxis, :]
+        plot_rollout_curves(rollout_actions, gt_actions, KOCH_MOTOR_NAMES,
+                           error_per_step, cum_error, ep_output_dir, episode_idx)
+
+    return log_data
+
+
+# ==============================================================================
+# Metrics
+# ==============================================================================
+
+def compute_metrics(predictions: np.ndarray, ground_truth: np.ndarray) -> Dict[str, np.ndarray]:
+    """
+    Compute error metrics between predictions and ground truth.
+
+    Args:
+        predictions: (F, 16, 6) predicted actions
+        ground_truth: (F, 16, 6) ground truth actions
+
+    Returns:
+        Dict with mse_overall, mae_overall, mse_per_joint, mae_per_joint
+    """
+    error = predictions - ground_truth  # (F, 16, 6)
+
+    mse_overall = np.mean(np.square(error))
+    mae_overall = np.mean(np.abs(error))
+
+    # Per-joint metrics (average over F and chunk_length)
+    mse_per_joint = np.square(error).mean(axis=(0, 1))  # (6,)
+    mae_per_joint = np.abs(error).mean(axis=(0, 1))     # (6,)
+
+    # Per-step metrics (average over F and joints)
+    mse_per_step = np.square(error).mean(axis=(0, 2))   # (16,)
+    mae_per_step = np.abs(error).mean(axis=(0, 2))      # (16,)
+
+    return {
+        "mse_overall": mse_overall,
+        "mae_overall": mae_overall,
+        "mse_per_joint": mse_per_joint,
+        "mae_per_joint": mae_per_joint,
+        "mse_per_step": mse_per_step,
+        "mae_per_step": mae_per_step,
+    }
+
+
+# ==============================================================================
+# Visualization
+# ==============================================================================
+
+def plot_action_curves(
+    predictions: np.ndarray,
+    ground_truth: np.ndarray,
+    joint_names: List[str],
+    output_dir: Path,
+    episode_idx: int,
+):
+    """
+    Plot predicted vs ground truth action curves for single-frame mode.
+
+    Args:
+        predictions: (F, 16, 6) predicted actions
+        ground_truth: (F, 16, 6) ground truth actions
+        joint_names: Names of the 6 joints
+        output_dir: Output directory for the plot
+        episode_idx: Episode index for title
+    """
+    num_joints = len(joint_names)
+    fig, axes = plt.subplots(2, 3, figsize=(18, 10))
+    fig.suptitle(f"Episode {episode_idx}: Predicted vs Ground Truth Actions (16-step chunks)", fontsize=14)
+
+    for j in range(num_joints):
+        ax = axes[j // 3, j % 3]
+
+        # Show 4 example frames evenly spaced
+        frame_indices = np.linspace(0, predictions.shape[0] - 1, min(4, predictions.shape[0])).astype(int)
+        colors = plt.cm.viridis(np.linspace(0, 1, len(frame_indices)))
+
+        for fi, (f_idx, color) in enumerate(zip(frame_indices, colors)):
+            gt = ground_truth[f_idx, :, j]   # (16,)
+            pred = predictions[f_idx, :, j]   # (16,)
+            steps = np.arange(16)
+
+            ax.plot(steps, gt, 'o-', color=color, alpha=0.5, linewidth=2,
+                   label=f'GT (f={f_idx})' if fi == 0 else None)
+            ax.plot(steps, pred, 's--', color=color, alpha=0.7, linewidth=2,
+                   label=f'Pred (f={f_idx})' if fi == 0 else None)
+
+        ax.set_title(joint_names[j])
+        ax.set_xlabel("Chunk step")
+        ax.set_ylabel("Joint position")
+        ax.legend(fontsize=7)
+        ax.grid(True, alpha=0.3)
+
+    plt.tight_layout()
+    plt.savefig(output_dir / "action_curves.png", dpi=150, bbox_inches='tight')
+    plt.close()
+    logger.info(f"[Episode {episode_idx}] Action curves saved to {output_dir / 'action_curves.png'}")
+
+
+def plot_rollout_curves(
+    rollout_actions: np.ndarray,
+    gt_actions: np.ndarray,
+    joint_names: List[str],
+    error_per_step: np.ndarray,
+    cum_error: np.ndarray,
+    output_dir: Path,
+    episode_idx: int,
+):
+    """
+    Plot rollout action curves and error metrics for RTC mode.
+
+    Args:
+        rollout_actions: (T, 6) predicted actions executed
+        gt_actions: (T, 6) ground truth actions
+        joint_names: Names of the 6 joints
+        error_per_step: (T,) per-step MSE
+        cum_error: (T,) cumulative MSE
+        output_dir: Output directory
+        episode_idx: Episode index
+    """
+    T = len(rollout_actions)
+    num_joints = len(joint_names)
+    time_steps = np.arange(T)
+
+    fig, axes = plt.subplots(3, 3, figsize=(20, 15))
+    fig.suptitle(f"Episode {episode_idx}: RTC Rollout Results", fontsize=14)
+
+    # Plot each joint (top 2 rows, 6 joints)
+    for j in range(num_joints):
+        ax = axes[j // 3, j % 3]
+        ax.plot(time_steps, gt_actions[:, j], 'b-', linewidth=1, alpha=0.6, label='Ground Truth')
+        ax.plot(time_steps, rollout_actions[:, j], 'r--', linewidth=1, alpha=0.8, label='Predicted')
+        ax.set_title(joint_names[j])
+        ax.set_xlabel("Step")
+        ax.set_ylabel("Position")
+        ax.legend(fontsize=7)
+        ax.grid(True, alpha=0.3)
+
+    # Plot per-step error
+    ax_err = axes[2, 0]
+    ax_err.plot(time_steps, error_per_step, 'k-', linewidth=0.5, alpha=0.7)
+    ax_err.set_title("Per-Step MSE")
+    ax_err.set_xlabel("Step")
+    ax_err.set_ylabel("MSE")
+    ax_err.grid(True, alpha=0.3)
+
+    # Plot cumulative error
+    ax_cum = axes[2, 1]
+    ax_cum.plot(time_steps, cum_error, 'r-', linewidth=1.5)
+    ax_cum.set_title("Cumulative MSE")
+    ax_cum.set_xlabel("Step")
+    ax_cum.set_ylabel("Cumulative MSE")
+    ax_cum.grid(True, alpha=0.3)
+
+    # Hide unused subplot
+    axes[2, 2].set_visible(False)
+
+    plt.tight_layout()
+    plt.savefig(output_dir / "rollout_curves.png", dpi=150, bbox_inches='tight')
+    plt.close()
+    logger.info(f"[Episode {episode_idx}] Rollout curves saved to {output_dir / 'rollout_curves.png'}")
+
+
+# ==============================================================================
+# Main Entry Point
+# ==============================================================================
+
+def parse_args():
+    parser = argparse.ArgumentParser(
+        description="Being-H05 Offline Video Inference",
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+        epilog="""
+Examples:
+  # Single-frame inference
+  python offline_inference.py \\
+      --data_path origin_data_v21/koch_follower/pick_orange_simple_shape \\
+      --checkpoint Being-H05/checkpoints/koch_all_data_20260603_214251/0010000 \\
+      --output_dir output/inference/pick_orange_simple_shape \\
+      --mode single_frame
+
+  # RTC rollout inference
+  python offline_inference.py \\
+      --data_path origin_data_v21/koch_follower/pick_orange_simple_shape \\
+      --checkpoint Being-H05/checkpoints/koch_all_data_20260603_214251/0010000 \\
+      --output_dir output/inference/pick_orange_simple_shape \\
+      --mode rtc_rollout \\
+      --n_action_steps 4
+        """,
+    )
+
+    # Required arguments
+    parser.add_argument("--data_path", type=str, required=True,
+                       help="Path to LeRobot v2.1 dataset directory")
+    parser.add_argument("--checkpoint", type=str, required=True,
+                       help="Path to Being-H05 checkpoint directory (containing safetensors + config.json)")
+    parser.add_argument("--output_dir", type=str, required=True,
+                       help="Output directory for inference results")
+    parser.add_argument("--mode", type=str, default="single_frame",
+                       choices=["single_frame", "rtc_rollout"],
+                       help="Inference mode: 'single_frame' or 'rtc_rollout'")
+
+    # Optional arguments
+    parser.add_argument("--task", type=str, default=None,
+                       help="Task instruction (auto-detected from tasks.jsonl if not provided)")
+    parser.add_argument("--episodes", type=int, default=0,
+                       help="Number of episodes to infer (0=all)")
+    parser.add_argument("--data_config_name", type=str, default="koch_follower",
+                       help="Being-H05 data config name")
+    parser.add_argument("--dataset_name", type=str, default="koch_posttrain",
+                       help="Dataset group name for metadata")
+    parser.add_argument("--embodiment_tag", type=str, default="koch",
+                       help="Robot embodiment identifier")
+    parser.add_argument("--n_action_steps", type=int, default=4,
+                       help="Number of steps to execute per chunk (RTC mode only)")
+    parser.add_argument("--enable_rtc", action="store_true", default=True,
+                       help="Enable Real-Time Chunking")
+    parser.add_argument("--num_inference_timesteps", type=int, default=None,
+                       help="Override flow matching ODE steps (default from checkpoint)")
+    parser.add_argument("--device", type=str, default="cuda" if torch.cuda.is_available() else "cpu",
+                       help="Inference device")
+    parser.add_argument("--no_plots", action="store_true",
+                       help="Skip generating visualization plots")
+    parser.add_argument("--metadata_variant", type=str, default=None,
+                       help="Metadata variant to use (e.g., 'pick_orange_simple_shape')")
+
+    return parser.parse_args()
+
+
+def main():
+    args = parse_args()
+
+    # Resolve paths
+    data_path = Path(args.data_path).resolve()
+    checkpoint_path = Path(args.checkpoint).resolve()
+    output_dir = Path(args.output_dir).resolve()
+
+    # Validate paths
+    if not data_path.exists():
+        logger.error(f"Data path does not exist: {data_path}")
+        sys.exit(1)
+    if not checkpoint_path.exists():
+        logger.error(f"Checkpoint path does not exist: {checkpoint_path}")
+        sys.exit(1)
+
+    # Check for required checkpoint files
+    required_files = ["config.json", "tokenizer.json"]
+    missing = [f for f in required_files if not (checkpoint_path / f).exists()]
+    # Also check for safetensors via glob (sharded or single)
+    safetensor_files = list(checkpoint_path.glob("*.safetensors"))
+    if not safetensor_files:
+        missing.append("*.safetensors (no safetensor files found)")
+
+    if missing:
+        logger.error(f"Missing required files in checkpoint directory: {missing}")
+        sys.exit(1)
+
+    # Create output directory
+    output_dir.mkdir(parents=True, exist_ok=True)
+    logger.info(f"Output directory: {output_dir}")
+
+    # =====================================================================
+    # Load dataset info
+    # =====================================================================
+    meta_dir = data_path / "meta"
+    info_path = meta_dir / "info.json"
+    if not info_path.exists():
+        logger.error(f"Dataset info.json not found: {info_path}")
+        sys.exit(1)
+
+    dataset_info = load_dataset_info(meta_dir)
+    total_episodes = dataset_info["total_episodes"]
+    logger.info(f"Dataset: {total_episodes} episodes, {dataset_info['total_frames']} total frames")
+
+    # Get task instruction
+    instruction = args.task
+    if instruction is None:
+        instruction = load_task_instruction(meta_dir)
+    logger.info(f"Task instruction: '{instruction}'")
+
+    # Determine episodes to process
+    num_episodes = args.episodes if args.episodes > 0 else total_episodes
+    num_episodes = min(num_episodes, total_episodes)
+    logger.info(f"Processing {num_episodes} episodes")
+
+    # =====================================================================
+    # Load Being-H05 Policy
+    # =====================================================================
+    logger.info(f"\n{'='*60}")
+    logger.info(f"Loading Being-H05 model from: {checkpoint_path}")
+    logger.info(f"Device: {args.device}")
+    logger.info(f"{'='*60}\n")
+
+    # Instruction template matching training
+    instruction_template = (
+        "According to the instruction '{task_description}', "
+        "what's the micro-step actions in the next {k} steps?"
+    )
+
+    try:
+        policy = BeingHPolicy(
+            model_path=str(checkpoint_path),
+            data_config_name=args.data_config_name,
+            dataset_name=args.dataset_name,
+            embodiment_tag=args.embodiment_tag,
+            instruction_template=instruction_template,
+            max_view_num=-1,
+            use_fixed_view=False,
+            action_attn_mode="causal",
+            device=args.device,
+            enable_rtc=args.enable_rtc,
+            num_inference_timesteps=args.num_inference_timesteps,
+            metadata_variant=args.metadata_variant,
+        )
+    except Exception as e:
+        logger.error(f"Failed to load BeingHPolicy: {e}")
+        logger.error(traceback.format_exc())
+        sys.exit(1)
+
+    logger.info("Model loaded successfully ✓\n")
+
+    # =====================================================================
+    # Save inference configuration
+    # =====================================================================
+    config_record = {
+        "data_path": str(data_path),
+        "checkpoint": str(checkpoint_path),
+        "mode": args.mode,
+        "task": instruction,
+        "num_episodes": num_episodes,
+        "data_config_name": args.data_config_name,
+        "dataset_name": args.dataset_name,
+        "embodiment_tag": args.embodiment_tag,
+        "action_chunk_length": policy.action_chunk_length,
+        "num_inference_timesteps": policy.model.config.num_inference_timesteps,
+        "enable_rtc": args.enable_rtc,
+        "n_action_steps": args.n_action_steps,
+        "device": args.device,
+        "metadata_variant": args.metadata_variant,
+        "stats_level": policy.stats_level,
+        "stats_source": policy.stats_source,
+    }
+    with open(output_dir / "inference_config.json", "w") as f:
+        json.dump(config_record, f, indent=2, default=str)
+
+    # =====================================================================
+    # Run Inference
+    # =====================================================================
+    data_dir = data_path
+    videos_dir = data_path / "videos"
+    save_plots = not args.no_plots
+
+    all_results = []
+    total_start = time.perf_counter()
+
+    for ep_idx in range(num_episodes):
+        logger.info(f"\n{'='*60}")
+        logger.info(f"Episode {ep_idx}/{num_episodes}")
+        logger.info(f"{'='*60}")
+
+        ep_start = time.perf_counter()
+
+        try:
+            if args.mode == "single_frame":
+                result = run_single_frame_inference(
+                    policy=policy,
+                    data_dir=data_dir,
+                    videos_dir=videos_dir,
+                    episode_idx=ep_idx,
+                    instruction=instruction,
+                    output_dir=output_dir,
+                    save_plots=save_plots,
+                )
+            elif args.mode == "rtc_rollout":
+                result = run_rtc_rollout_inference(
+                    policy=policy,
+                    data_dir=data_dir,
+                    videos_dir=videos_dir,
+                    episode_idx=ep_idx,
+                    instruction=instruction,
+                    output_dir=output_dir,
+                    n_action_steps=args.n_action_steps,
+                    save_plots=save_plots,
+                )
+            else:
+                raise ValueError(f"Unknown mode: {args.mode}")
+
+            ep_elapsed = time.perf_counter() - ep_start
+            result["episode_time_s"] = ep_elapsed
+            all_results.append(result)
+
+            logger.info(f"[Episode {ep_idx}] Time: {ep_elapsed:.1f}s")
+
+        except Exception as e:
+            logger.error(f"[Episode {ep_idx}] Failed: {e}")
+            logger.error(traceback.format_exc())
+            all_results.append({"episode_idx": ep_idx, "error": str(e)})
+
+    total_elapsed = time.perf_counter() - total_start
+
+    # =====================================================================
+    # Generate Summary
+    # =====================================================================
+    logger.info(f"\n{'='*60}")
+    logger.info(f"Inference Complete")
+    logger.info(f"{'='*60}")
+    logger.info(f"Total time: {total_elapsed:.1f}s ({total_elapsed/60:.1f} min)")
+    logger.info(f"Episodes: {len(all_results)}")
+
+    successful = [r for r in all_results if "error" not in r]
+    if successful:
+        avg_mse = np.mean([r["mse_overall"] for r in successful])
+        avg_mae = np.mean([r["mae_overall"] for r in successful])
+        avg_time = np.mean([r.get("avg_inference_time_s", 0) for r in successful])
+        logger.info(f"Successful episodes: {len(successful)}/{len(all_results)}")
+        logger.info(f"Average MSE: {avg_mse:.6f}")
+        logger.info(f"Average MAE: {avg_mae:.6f}")
+        logger.info(f"Average inference time: {avg_time:.4f}s")
+
+    # Save summary
+    summary = {
+        "total_time_s": total_elapsed,
+        "num_episodes_total": len(all_results),
+        "num_episodes_successful": len(successful),
+        "num_episodes_failed": len(all_results) - len(successful),
+        "results": all_results,
+        "config": config_record,
+    }
+    with open(output_dir / "summary.json", "w") as f:
+        json.dump(summary, f, indent=2, default=str)
+
+    logger.info(f"\nResults saved to: {output_dir}")
+    logger.info(f"Summary: {output_dir / 'summary.json'}")
+    logger.info(f"Config: {output_dir / 'inference_config.json'}")
+
+
+if __name__ == "__main__":
+    main()
