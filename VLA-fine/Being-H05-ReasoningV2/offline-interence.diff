+                        single_task=cfg.dataset.single_task if cfg.dataset else None,
+                        display_data=cfg.display_data,
+                        display_compressed_images=display_compressed,
+                    )
+
+                # Reset between episodes
+                if not events.get("stop_recording", False) and recorded_episodes < num_episodes - 1:
+                    log_say("Reset the environment", cfg.play_sounds)
+                    time.sleep(cfg.control.reset_time_s)
+
+                if dataset is not None:
+                    dataset.save_episode()
+                recorded_episodes += 1
+
+    except KeyboardInterrupt:
+        logging.info("Interrupted by user")
+    finally:
+        log_say("Stopping", cfg.play_sounds, blocking=True)
+
+        if dataset is not None:
+            dataset.finalize()
+        if robot.is_connected:
+            robot.disconnect()
+        if teleop is not None and teleop.is_connected:
+            teleop.disconnect()
+        if not is_headless() and listener is not None:
+            listener.stop()
+
+        # Push to hub if configured
+        if cfg.dataset is not None and cfg.dataset.push_to_hub:
+            if dataset is not None and dataset.num_episodes > 0:
+                dataset.push_to_hub(tags=cfg.dataset.tags, private=cfg.dataset.private)
+            else:
+                logging.warning("No episodes saved — skipping push to hub")
+
+        log_say("Exiting", cfg.play_sounds)
+
+    return dataset
+
+
