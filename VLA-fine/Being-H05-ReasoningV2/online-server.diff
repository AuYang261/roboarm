@@ -0,0 +1,296 @@
+"""Inference engine — Being-H05 model loading + single-frame inference.
+
+Wraps BeingHPolicy for the remote server use case:
+
+Key design decision: the client sends video streams but NOT joint state.
+To bridge this gap, the engine maintains an estimated state that is
+updated from the predicted action after each inference. This works
+because in the Koch follower format, action = absolute joint position
+command, so the predicted action serves as a valid state estimate for
+the next inference step.
+
+State initialization: uses the per-joint mean values from the dataset
+metadata (loaded from the checkpoint's metadata.json).
+
+Usage:
+    engine = InferenceEngine(
+        checkpoint=".../0010000",
+        data_config_name="koch_follower",
+        dataset_name="koch_posttrain",
+        embodiment_tag="koch",
+    )
+    result = engine.infer(top_bgr, wrist_bgr)
+    # result: {"arm_joint_position": (16,5), "gripper_position": (16,1)}
+"""
+
+import json
+import logging
+import sys
+import time
+from pathlib import Path
+from typing import Any, Dict, Optional
+
+import numpy as np
+import torch
+
+# Ensure Being-H05 is importable
+_script_dir = Path(__file__).resolve().parent
+_beingh_root = _script_dir.parent / "Being-H05"
+if str(_beingh_root) not in sys.path:
+    sys.path.insert(0, str(_beingh_root))
+
+from BeingH.inference.beingh_policy import BeingHPolicy
+
+logger = logging.getLogger(__name__)
+
+# Default joint order for Koch follower (same as client)
+JOINT_NAMES = [
+    "shoulder_pan",
+    "shoulder_lift",
+    "elbow_flex",
+    "wrist_flex",
+    "wrist_roll",
+    "gripper",
+]
+
+# Default task instruction (matches training data)
+DEFAULT_INSTRUCTION = "pick the orange toy and place into box"
+
+# Fallback initial state (mean values from dataset). Overridden by
+# metadata means if available.
+FALLBACK_STATE_MEANS = np.array(
+    [7.90, -40.51, -13.79, -52.57, 2.06, 44.70],
+    dtype=np.float32,
+)
+
+
+class InferenceEngine:
+    """Load Being-H05 model and provide single-frame inference.
+
+    State estimation strategy:
+    - On init: state = metadata mean values
+    - After each inference: state = predicted_action[0] (first chunk step)
+
+    This self-consistent state feedback allows the server to operate
+    without receiving explicit motor state from the client.
+    """
+
+    def __init__(
+        self,
+        checkpoint: str,
+        data_config_name: str = "koch_follower",
+        dataset_name: str = "koch_posttrain",
+        embodiment_tag: str = "koch",
+        instruction: str = DEFAULT_INSTRUCTION,
+        device: str = "cuda" if torch.cuda.is_available() else "cpu",
+        enable_rtc: bool = False,
+        num_inference_timesteps: Optional[int] = None,
+        metadata_variant: Optional[str] = None,
+    ):
+        """Load the Being-H05 model and initialize state.
+
+        Args:
+            checkpoint: Path to the checkpoint directory
+                        (containing safetensors, config.json, metadata).
+            data_config_name: Data configuration name.
+            dataset_name: Dataset group name for metadata.
+            embodiment_tag: Robot embodiment identifier.
+            instruction: Task instruction text.
+            device: Inference device.
+            enable_rtc: Enable Real-Time Chunking (disabled by default
+                        for server — client handles chunking).
+            num_inference_timesteps: Override Flow Matching steps.
+            metadata_variant: Specific metadata variant for stats.
+        """
+        self._checkpoint = Path(checkpoint).resolve()
+        self._instruction = instruction
+        self._device = device
+
+        logger.info(f"Loading Being-H05 from: {self._checkpoint}")
+        t0 = time.perf_counter()
+
+        # Instruction template matching training
+        instruction_template = (
+            "According to the instruction '{task_description}', "
+            "what's the micro-step actions in the next {k} steps?"
+        )
+
+        self._policy = BeingHPolicy(
+            model_path=str(self._checkpoint),
+            data_config_name=data_config_name,
+            dataset_name=dataset_name,
+            embodiment_tag=embodiment_tag,
+            instruction_template=instruction_template,
+            max_view_num=-1,
+            use_fixed_view=False,
+            action_attn_mode="causal",
+            device=device,
+            enable_rtc=enable_rtc,
+            num_inference_timesteps=num_inference_timesteps,
+            metadata_variant=metadata_variant,
+        )
+
+        self._action_chunk_length = self._policy.action_chunk_length  # 16
+
+        # Initialize estimated state from metadata means
+        self._state_6d = self._load_initial_state()
+
+        load_time = time.perf_counter() - t0
+        logger.info(
+            f"InferenceEngine ready ({load_time:.1f}s) | "
+            f"chunk_length={self._action_chunk_length} | "
+            f"device={device} | "
+            f"rtc={enable_rtc}"
+        )
+        logger.info(
+            f"Initial state: {dict(zip(JOINT_NAMES, self._state_6d.round(1)))}"
+        )
+
+    def _load_initial_state(self) -> np.ndarray:
+        """Load initial state from metadata mean values.
+
+        Returns:
+            numpy array of shape (6,) — [sp, sl, ef, wf, wr, gripper].
+        """
+        try:
+            metadata_path = self._checkpoint / "koch_posttrain_metadata.json"
+            if metadata_path.exists():
+                with open(metadata_path, "r") as f:
+                    meta = json.load(f)
+                # Navigate to state statistics
+                stats = meta.get("koch_posttrain", meta)
+                if "koch_posttrain_variants" in meta:
+                    # Use first available variant
+                    variants = meta["koch_posttrain_variants"]
+                    first_key = next(iter(variants))
+                    stats = variants[first_key]
+                state_stats = stats.get("statistics", {}).get("state", {})
+                arm_mean = np.array(
+                    state_stats.get("arm_joint_position", {}).get("mean", FALLBACK_STATE_MEANS[:5]),
+                    dtype=np.float32,
+                )
+                grip_mean = np.array(
+                    state_stats.get("gripper_position", {}).get("mean", FALLBACK_STATE_MEANS[5:]),
+                    dtype=np.float32,
+                )
+                means = np.concatenate([arm_mean, grip_mean])
+                logger.info(f"Loaded initial state from metadata: {means.round(1)}")
+                return means
+        except Exception as e:
+            logger.warning(f"Failed to load metadata means: {e}")
+
+        logger.warning(f"Using fallback initial state: {FALLBACK_STATE_MEANS}")
+        return FALLBACK_STATE_MEANS.copy()
+
+    # ── Inference ────────────────────────────────────────────────────
+
+    def infer(
+        self,
+        top_bgr: np.ndarray,
+        wrist_bgr: np.ndarray,
+    ) -> Dict[str, Any]:
+        """Run single-frame inference and update estimated state.
+
+        Args:
+            top_bgr: Top camera frame, BGR (480, 640, 3) uint8.
+            wrist_bgr: Wrist camera frame, BGR (480, 640, 3) uint8.
+
+        Returns:
+            Dict with keys:
+                - arm_joint_position: (16, 5) float — predicted joint
+                  angles in degrees.
+                - gripper_position: (16, 1) float — predicted gripper
+                  position [0, 100].
+                - inference_time_ms: float — inference latency.
+        """
+        # Convert BGR → RGB for the model
+        top_rgb = _bgr_to_rgb(top_bgr)
+        wrist_rgb = _bgr_to_rgb(wrist_bgr)
+
+        # Build observation dict
+        # Note: state keys must come first (see §3.1 issue #2 in H05推理.md)
+        obs = {
+            "state.arm_joint_position": self._state_6d[:5].copy().astype(np.float32),
+            "state.gripper_position": self._state_6d[5:6].copy().astype(np.float32),
+            "video.above": top_rgb.astype(np.uint8),
+            "video.wrist": wrist_rgb.astype(np.uint8),
+            "language.instruction": [self._instruction],
+        }
+
+        # Run inference
+        t0 = time.perf_counter()
+        result = self._policy.get_action(obs)
+        elapsed_ms = (time.perf_counter() - t0) * 1000.0
+
+        # Extract predictions
+        arm_joint = np.array(result["action.arm_joint_position"], dtype=np.float32)
+        gripper = np.array(result["action.gripper_position"], dtype=np.float32)
+
+        # Update state estimate from first predicted step
+        # (action = absolute position in Koch format)
+        pred_step0 = np.concatenate([arm_joint[0], gripper[0]], axis=-1)
+        self._state_6d = pred_step0.astype(np.float32)
+
+        logger.debug(
+            f"Inference: {elapsed_ms:.1f}ms | "
+            f"arm[0]={arm_joint[0].round(1)} | "
+            f"gripper[0]={gripper[0].round(1)}"
+        )
+
+        return {
+            "arm_joint_position": arm_joint.tolist(),    # (16, 5)
+            "gripper_position": gripper.tolist(),         # (16, 1)
+            "inference_time_ms": round(elapsed_ms, 1),
+        }
+
+    # ── State management ─────────────────────────────────────────────
+
+    def set_state(self, state_6d: np.ndarray) -> None:
+        """Override the estimated state (e.g., from client feedback).
+
+        Args:
+            state_6d: Joint state (6,) in degrees
+                      [sp, sl, ef, wf, wr, gripper].
+        """
+        if state_6d.shape != (6,):
+            raise ValueError(f"Expected state shape (6,), got {state_6d.shape}")
+        self._state_6d = state_6d.astype(np.float32).copy()
+        logger.debug(f"State set: {dict(zip(JOINT_NAMES, self._state_6d.round(1)))}")
+
+    def get_state(self) -> np.ndarray:
+        """Return the current estimated state.
+
+        Returns:
+            numpy array (6,) in degrees.
+        """
+        return self._state_6d.copy()
+
+    def reset_state(self) -> None:
+        """Reset state to metadata mean values."""
+        self._state_6d = self._load_initial_state()
+        logger.info("State reset to metadata means")
+
+    # ── Properties ───────────────────────────────────────────────────
+
+    @property
+    def action_chunk_length(self) -> int:
+        """Action chunk length (16)."""
+        return self._action_chunk_length
+
+    @property
+    def instruction(self) -> str:
+        """Current task instruction."""
+        return self._instruction
+
+    @property
+    def policy(self) -> BeingHPolicy:
+        """The underlying BeingHPolicy instance."""
+        return self._policy
+
+
+# ── Helpers ──────────────────────────────────────────────────────────
+
+
+def _bgr_to_rgb(frame: np.ndarray) -> np.ndarray:
+    """Convert BGR (OpenCV default) to RGB for the model."""
+    return frame[..., ::-1].copy()  # BGR → RGB
