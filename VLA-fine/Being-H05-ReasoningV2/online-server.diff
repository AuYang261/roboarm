+#!/usr/bin/env python3
+"""Being-H05 Remote Inference Server — main entry point.
+
+Receives JPEG video streams from client via UDP (:5002 top, :5003 wrist),
+runs Being-H05 VLA inference, sends predicted action sequences back to
+client via UDP (192.168.2.5:5000).
+
+Architecture:
+    ┌─────────────────────────────────────────────────────┐
+    │                  server_main.py                     │
+    │                                                     │
+    │  :5002 ─→ FrameReceiver ─┐                          │
+    │                           ├─→ InferenceEngine.infer()│
+    │  :5003 ─→ FrameReceiver ─┘     │                    │
+    │                                 ▼                    │
+    │                           Action JSON                │
+    │                                 │                    │
+    │                    192.168.2.5:5000 ←─ ActionSender  │
+    └─────────────────────────────────────────────────────┘
+
+Usage:
+    # Default settings
+    python server/server_main.py
+
+    # Custom checkpoint and ports
+    python server/server_main.py \\
+        --checkpoint Being-H05/checkpoints/koch_all_data_20260603_214251/0010000 \\
+        --top-port 5002 \\
+        --wrist-port 5003 \\
+        --action-host 192.168.2.5 \\
+        --action-port 5000
+
+    # With task metadata variant
+    python server/server_main.py \\
+        --metadata-variant pick_orange_simple_shape
+"""
+
+import argparse
+import logging
+import signal
+import sys
+import time
+from pathlib import Path
+
+# Ensure project root and Being-H05 are importable
+_script_dir = Path(__file__).resolve().parent
+_project_root = _script_dir.parent
+if str(_project_root) not in sys.path:
+    sys.path.insert(0, str(_project_root))
+
+from server.udp_receiver import DualReceiver
+from server.inference_engine import InferenceEngine
+from server.udp_sender import ActionSender, DEFAULT_ACTION_HOST, DEFAULT_ACTION_PORT
+
+logger = logging.getLogger(__name__)
+
+# Defaults
+DEFAULT_CHECKPOINT = "Being-H05/checkpoints/koch_all_data_20260603_214251/0010000"
+DEFAULT_TOP_PORT = 5002
+DEFAULT_WRIST_PORT = 5003
+DEFAULT_INFERENCE_INTERVAL_MS = 66  # ~15 FPS inference rate
+
+
+class InferenceServer:
+    """Top-level server orchestrating UDP receive → inference → UDP send."""
+
+    def __init__(self, config: argparse.Namespace):
+        self._config = config
+        self._running = False
+        self._sequence_id = 0
+        self._inference_count = 0
+        self._start_time = 0.0
+
+        # Sub-modules (created in start)
+        self._receiver: DualReceiver | None = None
+        self._engine: InferenceEngine | None = None
+        self._sender: ActionSender | None = None
+
+    # ── Lifecycle ────────────────────────────────────────────────────
+
+    def start(self) -> None:
+        """Initialize all modules and enter the main inference loop."""
+        logger.info("=" * 60)
+        logger.info("  Being-H05 Remote Inference Server")
+        logger.info(f"  Checkpoint: {self._config.checkpoint}")
+        logger.info(f"  Receiving:  0.0.0.0:{self._config.top_port} (top)")
+        logger.info(f"              0.0.0.0:{self._config.wrist_port} (wrist)")
+        logger.info(f"  Sending:    {self._config.action_host}:{self._config.action_port}")
+        logger.info(f"  Inference interval: {self._config.inference_interval_ms}ms")
+        logger.info(f"  RTC: {'enabled' if self._config.enable_rtc else 'disabled'}")
+        logger.info("=" * 60)
+
+        # ── Initialize modules ──
+        logger.info("Initializing UDP receivers...")
+        self._receiver = DualReceiver(
+            top_port=self._config.top_port,
+            wrist_port=self._config.wrist_port,
+            timeout_ms=self._config.receiver_timeout_ms,
+        )
+
+        logger.info("Loading Being-H05 model...")
+        self._engine = InferenceEngine(
+            checkpoint=self._config.checkpoint,
+            data_config_name=self._config.data_config_name,
+            dataset_name=self._config.dataset_name,
+            embodiment_tag=self._config.embodiment_tag,
+            instruction=self._config.task,
+            device=self._config.device,
+            enable_rtc=self._config.enable_rtc,
+            num_inference_timesteps=self._config.num_inference_timesteps,
+            metadata_variant=self._config.metadata_variant,
+        )
+
+        logger.info("Initializing action sender...")
+        self._sender = ActionSender(
+            remote_host=self._config.action_host,
+            remote_port=self._config.action_port,
+        )
+
+        # ── Wait for first frames ──
+        logger.info("Waiting for video streams from client...")
+        wait_start = time.perf_counter()
+        while not self._receiver.both_ready():
+            if time.perf_counter() - wait_start > 30.0:
+                logger.error(
+                    "Timeout waiting for video streams (30s). "
+                    "Check that the client is running and sending to the correct ports."
+                )
+                self.stop()
+                return
+            time.sleep(0.1)
+        logger.info(
+            f"Both streams active (top: {self._receiver.top.packets_received} pkts, "
+            f"wrist: {self._receiver.wrist.packets_received} pkts)"
+        )
+
+        # ── Main loop ──
+        self._running = True
+        self._start_time = time.perf_counter()
+        try:
+            self._main_loop()
+        except KeyboardInterrupt:
+            logger.info("Interrupted by user")
+        finally:
+            self.stop()
+
+    def stop(self) -> None:
+        """Cleanly shut down all modules."""
+        self._running = False
+
+        if self._sender is not None:
+            self._sender.close()
+        if self._receiver is not None:
+            self._receiver.close()
+
+        # Summary
+        elapsed = time.perf_counter() - self._start_time
+        logger.info("=" * 60)
+        logger.info("  Server stopped")
+        logger.info(f"  Inferences: {self._inference_count}")
+        logger.info(f"  Duration: {elapsed:.1f}s")
+        if elapsed > 0:
+            logger.info(f"  Avg rate: {self._inference_count / elapsed:.1f} Hz")
+        if self._sender is not None:
+            logger.info(f"  Actions sent: {self._sender.packets_sent}")
+            logger.info(f"  Data sent: {self._sender.bytes_sent / 1e3:.1f} KB")
+        logger.info("=" * 60)
+
+    # ── Main Loop ────────────────────────────────────────────────────
+
+    def _main_loop(self) -> None:
+        """Main inference loop:
+        1. Receive latest frames from both cameras
+        2. If both frames available, run inference
+        3. Send action JSON to client
+        4. Pace to target inference rate
+        """
+        interval_s = self._config.inference_interval_ms / 1000.0
+        fps_smooth = 1.0 / interval_s if interval_s > 0 else 15.0
+
+        logger.info(
+            f"Main loop started (interval={interval_s:.3f}s, "
+            f"target={1.0/interval_s:.1f} Hz)"
+        )
+
+        while self._running:
+            loop_start = time.perf_counter()
+
+            # 1. Receive latest frames
+            frames = self._receiver.recv_both()
+
+            # 2. Run inference if both frames are available
+            if frames.top_bgr is not None and frames.wrist_bgr is not None:
+                try:
+                    result = self._engine.infer(frames.top_bgr, frames.wrist_bgr)
+                    inference_ms = result["inference_time_ms"]
+
+                    # 3. Send action to client
+                    self._sequence_id += 1
+                    action_msg = {
+                        "sequence_id": self._sequence_id,
+                        "chunk_size": self._engine.action_chunk_length,
+                        "inference_time_ms": inference_ms,
+                        "action": {
+                            "arm_joint_position": result["arm_joint_position"],
+                            "gripper_position": result["gripper_position"],
+                        },
+                    }
+                    self._sender.send_json(action_msg)
+                    self._inference_count += 1
+
+                    # Periodic status
+                    if self._inference_count % 150 == 0:
+                        elapsed = time.perf_counter() - self._start_time
+                        logger.info(
+                            f"[inference {self._inference_count}] "
+                            f"seq={self._sequence_id} | "
+                            f"latency={inference_ms:.0f}ms | "
+                            f"rate={self._inference_count / elapsed:.1f} Hz | "
+                            f"fps={fps_smooth:.1f}"
+                        )
+
+                except Exception as e:
+                    logger.error(f"Inference failed: {e}", exc_info=True)
+
+            # 4. Frame rate control
+            elapsed = time.perf_counter() - loop_start
+            if elapsed < interval_s:
+                time.sleep(interval_s - elapsed)
+            actual_elapsed = time.perf_counter() - loop_start
+            if actual_elapsed > 0:
+                fps_smooth = 0.9 * fps_smooth + 0.1 * (1.0 / actual_elapsed)
+
+
+# ── CLI ──────────────────────────────────────────────────────────────
+
+
+def parse_args() -> argparse.Namespace:
+    """Parse command-line arguments."""
+    parser = argparse.ArgumentParser(
+        description="Being-H05 Remote Inference Server",
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+        epilog="""
+Examples:
+  # Default settings
+  python server/server_main.py
+
+  # Custom checkpoint
+  python server/server_main.py \\
+      --checkpoint Being-H05/checkpoints/koch_all_data_20260603_214251/0010000
+
+  # Enable RTC mode
+  python server/server_main.py --enable-rtc
+
+  # With metadata variant
+  python server/server_main.py --metadata-variant pick_orange_simple_shape
+        """,
+    )
+
+    # Checkpoint
+    parser.add_argument(
+        "--checkpoint", type=str, default=DEFAULT_CHECKPOINT,
+        help="Path to Being-H05 checkpoint directory",
+    )
+
+    # Network — receive
+    parser.add_argument(
+        "--top-port", type=int, default=DEFAULT_TOP_PORT,
+        help="UDP port for top camera (default: 5002)",
+    )
+    parser.add_argument(
+        "--wrist-port", type=int, default=DEFAULT_WRIST_PORT,
+        help="UDP port for wrist camera (default: 5003)",
+    )
+    parser.add_argument(
+        "--receiver-timeout-ms", type=int, default=5,
+        help="UDP recvfrom timeout in ms (default: 5)",
+    )
+
+    # Network — send
+    parser.add_argument(
+        "--action-host", type=str, default=DEFAULT_ACTION_HOST,
+        help="Client IP for action delivery (default: 192.168.2.5)",
+    )
+    parser.add_argument(
+        "--action-port", type=int, default=DEFAULT_ACTION_PORT,
+        help="Client UDP port for action delivery (default: 5000)",
+    )
+
+    # Inference
+    parser.add_argument(
+        "--inference-interval-ms", type=int, default=DEFAULT_INFERENCE_INTERVAL_MS,
+        help="Min interval between inference cycles in ms (default: 66, ~15Hz)",
+    )
+    parser.add_argument(
+        "--task", type=str, default="pick the orange toy and place into box",
+        help="Task instruction for inference",
+    )
+    parser.add_argument(
+        "--device", type=str, default="cuda",
+        help="Inference device (default: cuda)",
+    )
+    parser.add_argument(
+        "--enable-rtc", action="store_true", default=False,
+        help="Enable Real-Time Chunking with prefix locking",
+    )
+    parser.add_argument(
+        "--num-inference-timesteps", type=int, default=None,
+        help="Override Flow Matching ODE steps",
+    )
+    parser.add_argument(
+        "--data-config-name", type=str, default="koch_follower",
+        help="Data config name (default: koch_follower)",
+    )
+    parser.add_argument(
+        "--dataset-name", type=str, default="koch_posttrain",
+        help="Dataset name for metadata (default: koch_posttrain)",
+    )
+    parser.add_argument(
+        "--embodiment-tag", type=str, default="koch",
+        help="Robot embodiment tag (default: koch)",
+    )
+    parser.add_argument(
+        "--metadata-variant", type=str, default=None,
+        help="Metadata variant for normalization stats",
+    )
+
+    # Logging
+    parser.add_argument(
+        "--log-level", type=str, default="INFO",
+        choices=["DEBUG", "INFO", "WARNING", "ERROR"],
+        help="Logging level (default: INFO)",
+    )
+
+    return parser.parse_args()
+
+
+def main():
+    args = parse_args()
+
+    logging.basicConfig(
+        level=getattr(logging, args.log_level.upper(), logging.INFO),
+        format="%(asctime)s [%(levelname)-8s] %(message)s",
+        datefmt="%H:%M:%S",
+    )
+
+    # Resolve checkpoint path
+    checkpoint = Path(args.checkpoint)
+    if not checkpoint.is_absolute():
+        checkpoint = Path.cwd() / checkpoint
+    args.checkpoint = str(checkpoint.resolve())
+
+    if not checkpoint.exists():
+        logger.error(f"Checkpoint not found: {checkpoint}")
+        sys.exit(1)
+
+    # Handle graceful shutdown
+    server = InferenceServer(args)
+
+    def _signal_handler(signum, frame):
+        logger.info(f"Received signal {signum}, shutting down...")
+        server._running = False
+
+    signal.signal(signal.SIGINT, _signal_handler)
+    signal.signal(signal.SIGTERM, _signal_handler)
+
+    server.start()
+
+
+if __name__ == "__main__":
+    main()
