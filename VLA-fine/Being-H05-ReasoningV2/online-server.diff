+"""Being-H05 Remote Inference Server.
+
+Receives JPEG video streams from client, runs Being-H05 VLA inference,
+sends predicted action sequences back to client via UDP.
+
+Modules:
+    udp_receiver.py      — Non-blocking JPEG frame reception from :5002 / :5003
+    inference_engine.py  — Being-H05 model loading + inference
+    udp_sender.py        — Action JSON transmission to 192.168.2.5:5000
+    server_main.py       — Main entry point: orchestration loop
+"""
diff --git a/server/inference_engine.py b/server/inference_engine.py
